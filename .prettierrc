{
	"printWidth": 120,
	"tabWidth": 4,
	"useTabs": true,
	"semi": true,
	"singleQuote": true,
	"quoteProps": "preserve",
	"trailingComma": "all",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"arrowParens": "avoid",
	"plugins": ["prettier-plugin-jsdoc"],
	"jsdocSeparateReturnsFromParam": false,
	"jsdocSeparateTagGroups": false,
	"jsdocCommentLineStrategy": "keep"
}
